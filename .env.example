# Copy this file to .env and fill values, then restart server
# cp .env.example .env

# Twilio SMS provider settings
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Optional default destination for admin SMS code
ADMIN_PHONE_NUMBER=+15557654321

# Optional admin setup override code
ADMIN_OVERRIDE_CODE=restore-admin

# Optional environment mode
NODE_ENV=development

# SMTP email settings (used for password reset emails)
# Common values: smtp.gmail.com (port 587), smtp.mailgun.org, smtp-relay.sendgrid.net
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Sender name/address shown in the From field (defaults to SMTP_USER if blank)
SMTP_FROM=My Permanent Blog <you@gmail.com>
